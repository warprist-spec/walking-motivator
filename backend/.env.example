# Server
PORT=3000
NODE_ENV=production

# Database
DB_PATH=./data/app.db

# --- ChatAnywhere (OpenAI-совместимый API) ---
CHATANYWHERE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_BASE_URL=https://api.chatanywhere.tech/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_MODEL_VISION=gpt-4o-mini
OPENAI_TEMPERATURE=0.7

# AI-партнёр
AI_TIMEZONE=Europe/Berlin
AI_MORNING_HOUR=8
AI_EVENING_HOUR=21

# Webhook
WEBHOOK_SECRET=change_me_long_random_string

# CORS (через запятую)
ALLOWED_ORIGINS=https://lightly-manly-cater.tilda.ws,https://walking-motivator.duckdns.org

# Логи
LOG_LEVEL=info

# --- Telegram ---
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_ADMIN_CHAT_ID=your_chat_id_here

# --- Scheduler ---
SCHEDULER_ENABLED=false