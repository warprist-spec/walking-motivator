# Server
PORT=3000
NODE_ENV=development

# Database
DB_PATH=./data/app.db

# OpenAI (заполни ключом позже)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.7

# AI-партнёр
AI_TIMEZONE=Europe/Berlin
AI_MORNING_HOUR=8
AI_EVENING_HOUR=21

# Webhook
WEBHOOK_SECRET=change_me_long_random_string

# CORS (через запятую)
ALLOWED_ORIGINS=http://localhost:5500,https://your-project.tilda.ws

# Логи
LOG_LEVEL=info